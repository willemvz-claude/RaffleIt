<Window x:Class="AcTrackGenerator.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapui="clr-namespace:AcTrackGenerator.App.MapUi;assembly=App.MapUi"
        Title="AC Track Generator" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="12" FontSize="16"
                   Text="AC Track Generator — area selection (Phase 1 will wire this up to OSM extraction)" />

        <mapui:MapSelectionView Grid.Row="1" />
    </Grid>
</Window>
